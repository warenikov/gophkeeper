# Пример переменных окружения для локального стека GophKeeper.
# Скопируйте в .env и при необходимости поправьте значения:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=gophkeeper
POSTGRES_PASSWORD=gophkeeper
POSTGRES_DB=gophkeeper
POSTGRES_PORT=5432

# --- Сервер (используется начиная со Спринта 1) ---
# Строка подключения к БД для сервера.
# GOPHKEEPER_DATABASE_DSN=postgres://gophkeeper:gophkeeper@localhost:5432/gophkeeper?sslmode=disable
# Адрес, на котором слушает gRPC-сервер.
# GOPHKEEPER_GRPC_ADDRESS=:8081
# Секрет для подписи JWT (обязательно замените в проде).
# GOPHKEEPER_JWT_SECRET=change-me
